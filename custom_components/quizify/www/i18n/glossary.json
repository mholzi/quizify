      "lightning.title", "lightning.recapTitle", "wager.hostWindowTitle",
      "lobby.marqueeWaiting", "game.paused", "leaderboard.title"
    ]}
  },
  "acronyms": ["QR", "HA", "TV", "JSON", "URL", "ID", "IDs", "README", "WLAN", "TTS", "SFX", "DJ", "OK"],
