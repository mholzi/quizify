      "admin.kickConfirmBtn", "admin.pause", "admin.resume", "join.joinButton",
      "wager.submit", "hotSeat.bidSubmit", "estimate.submit", "share.button",
      "common.retry", "connection.retryConnection", "teams.openTeam", "teams.leaveTeam",
      "lightning.splashStart", "lightning.continueGame", "setup.savePresetBtn",
      "setup.deletePresetBtn", "setup.apply", "notHost.join"
    ]},
    "pill": {"max": 18, "keys": [
      "connection.connected", "connection.reconnecting", "connection.disconnected",
      "errors.RECONNECTING", "reveal.baseScore", "reveal.speedBonus", "reveal.difficulty",
      "game.sent", "game.submitted", "powerups.joker", "powerups.double_points",
